<%- include('partials/header') %>

<div class="container" style="margin-top: 30px; margin-bottom: 40px;">
    <div class="row">
        <div class="col s12 m10 offset-m1 l8 offset-l2">
            <div class="card z-depth-2" style="border-radius: 20px; overflow: hidden; padding: 10px;">
                <div class="card-content">
                    <span class="card-title center-align" style="font-weight: 700; color: #2979ff; margin-bottom: 25px;">
                        Registro de Usuario
                    </span>
                    
                    <form id="signUpForm">
                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input type="text" id="name" required>
                                <label for="name">Nombre</label>
                            </div>
                            <div class="input-field col s12 m6">
                                <input type="text" id="lastName" required>
                                <label for="lastName">Apellido</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input type="text" id="phoneNumber" required>
                                <label for="phoneNumber">Teléfono</label>
                            </div>
                            <div class="input-field col s12 m6">
                                <input type="date" id="birthdate" required>
                                <label for="birthdate" class="active">Fecha de Nacimiento</label>
                            </div>
                        </div>

                        <div class="input-field">
                            <input type="text" id="adress">
                            <label for="adress">Dirección</label>
                        </div>

                        <div class="input-field">
                            <input type="email" id="email" required>
                            <label for="email">Correo Electrónico</label>
                        </div>

                        <div class="input-field">
                            <input type="password" id="password" required>
                            <label for="password">Contraseña (Mín. 8 caracteres, 1 mayúscula, 1 número, 1 símbolo #$%&*@)</label>
                        </div>

                        <div style="margin-top: 25px;">
                            <button class="btn waves-effect waves-light" style="width: 100%; height: 48px; background-color: #2979ff; border-radius: 25px; font-weight: 600; font-size: 1rem;" type="submit">
                                Registrarse
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('signUpForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const payload = {
            name: document.getElementById('name').value,
            lastName: document.getElementById('lastName').value,
            phoneNumber: document.getElementById('phoneNumber').value,
            birthdate: document.getElementById('birthdate').value,
            adress: document.getElementById('adress').value,
            email: document.getElementById('email').value,
            password: document.getElementById('password').value
        };

        try {
            const res = await fetch('/api/auth/signUp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();

            if (res.ok) {
                M.toast({html: '¡Registro exitoso! Redirigiendo...', classes: 'green'});
                setTimeout(() => window.location.href = '/signIn', 1200);
            } else {
                M.toast({html: data.message || 'Error en el registro', classes: 'red'});
            }
        } catch (err) {
            M.toast({html: 'Error de conexión con el servidor', classes: 'red'});
        }
    });
</script>

<%- include('partials/footer') %>